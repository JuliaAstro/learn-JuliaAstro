$(begin
    import Pluto
    "The contents of `<head>` from a Pluto HTML export."
    const pluto_head = let
        default = Pluto.generate_html()
        m = match(r"<head.*?>(.*)</head>"s, default)
        reduce([
            # r"<script[^\n]data-pluto-file=[\"']?launch-parameters.*?/script>"s
            r"<title.*?/title>"
            r"<meta name=[\"']?description.*?>"
            r"<link rel=[\"']?icon.*?>"
        ]; init=m[1]) do s,r
            replace(s, r => "")
        end |> HTML
    end
    nothing
end)<html lang="en">
<head>

$(Pluto.frontmatter_html(page.output.frontmatter) |> HTML)

<link rel="root" href="$(root_url)" />
<link rel="icon" href="$(root_url)/assets/favicon.ico" />
<link rel="icon" href="$(root_url)/assets/favicon.svg" type="image/svg+xml">

<link rel="stylesheet" href="$(root_url)/assets/styles/layout.css" type="text/css" />
<script src="$(root_url)/assets/scripts/sidebar.js" type="module" defer blocking="render"></script>

<link rel="pp-search-data" href="$(root_url)/pp_search_data.json" />
<script src="https://cdn.jsdelivr.net/npm/lunr@2.3.9/lunr.min.js" integrity="sha256-DFDZACuFeAqEKv/7Vnu1Tt5ALa58bcWZegGGFNgET8g=" crossorigin="anonymous" defer></script>
<script src="$(root_url)/assets/scripts/search.js" type="module" defer></script>

$(pluto_head)
</head>
<body>
    <div id="pages-layout">
        <button id="toggle-nav" title="Open navigation"></button>
        <nav id="pages-sidebar" style="height: 100vh; overflow-y: auto; top: 0px;">
        <div>
        <ul>
            <li class="pluto_home_link"><a class="pluto_home_link" href=$(root_url)>$(let
                # Inline the logo so it paints together with the page instead of loading (and blinking) afterwards.
                svg = read(joinpath(@__DIR__, "..", "assets", "favicon.svg"), String)
                HTML(svg[first(findfirst("<svg", svg)):end])
            end)<span> learn.<br>JuliaAstro</span></a>
        </li>
                <li>
            <div class="search-bar">
                <form action="$(root_url)/search" method="GET">
                    <input type="search" name="q" placeholder="Search..." style="width: 100%">
                </form>
            </div>
        </li>
        $(let
            sidebar_data = Base.include(@__MODULE__, joinpath(@__DIR__, "..", "sidebar data.jl"))
            active = page.input.relative_path == "quickstart.jl"

            # Each tag links to the homepage gallery, filtered to that tag. On the homepage, gallery.js turns
            # these links into toggles that add or remove the tag from the current selection, and shows the
            # "Clear all tags" link while any tag is selected.
            @htl("""
            <li>
            <h3>Getting started</h3>
            <ul>
            <li class=$([active ? "active" : nothing])><a href=$(root_url * "/quickstart/")>Quickstart</a></li>
            </ul>
            </li>
            <li class="pp-clear-tags" hidden><ul><li><a href=$(root_url * "/")>Clear all tags</a></li></ul></li>
            $([
                @htl("""
                <li>
                <h3>$(heading)</h3>
                <ul>
                $([@htl("<li><a href=$(root_url * "/?tag=" * tag) data-tag=$(tag)>$(tag)</a></li>") for tag in tags])
                </ul>
                </li>
                """)
                for (heading, tags) in sidebar_data["tag_groups"]
            ])
            """)
        end)
        </ul>
        </div>
        </nav>
        <div id="pages-content">
        $(let
            tags = get(page.output.frontmatter, "tags", String[])
            # Each tag links to the homepage gallery, filtered to that tag.
            links = [@htl("<a href=$(root_url * "/?tag=" * tag)><code>$(tag)</code></a>") for tag in tags]
            isempty(tags) ? nothing : @htl("""
            <div class="pp-keywords">
                <div class="pp-keywords-box">
                    <p class="pp-keywords-title"></p>
                    <p>$(links)</p>
                </div>
            </div>
            """)
        end)
        $(content)
        </div>
    </div>
</body>
</html>
